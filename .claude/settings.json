{
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)"
    ],
    "deny": [
      "Bash(git -C * push *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * reset --hard *)",
      "Bash(git -C * clean *)",
      "Bash(rm -rf *)",
      "Bash(aws cloudformation deploy *)",
      "Bash(aws cloudformation delete-stack *)",
      "Bash(aws lambda update-function-code *)",
      "Bash(dotnet lambda deploy-function *)",
      "Bash(dotnet lambda deploy-serverless *)",
      "Bash(fastlane *)",
      "Bash(xcrun altool *)",
      "Bash(xcrun notarytool *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/enforce-one-repo-per-session.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-upstream-updates.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/token-log-start.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/token-log-stop.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_TOKEN_DAILY_LIMIT": "1000000"
  }
}
